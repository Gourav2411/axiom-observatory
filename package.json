{
  "name": "axiom-observatory",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/start-local-dev.mjs --host 0.0.0.0 --port 4174 --strictPort",
    "dev:web": "vite",
    "chemistry:start": "MPLCONFIGDIR=.runtime/matplotlib AXIOM_CHEMISTRY_PORT=8791 .runtime/chemistry/bin/python services/chemistry_worker.py",
    "campaign:start": "node scripts/campaign-worker.mjs",
    "serve:production": "node scripts/serve-production.mjs",
    "start:production": "node scripts/start-production.mjs",
    "build": "vite build",
    "build:sites": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/evidence-api.test.mjs tests/rag-pipeline.test.mjs tests/auth-flow.test.mjs tests/axiom-embed-contract.test.mjs tests/supabase-schema.test.mjs tests/embedding-client.test.mjs tests/chemistry-contract.test.mjs tests/campaign-contract.test.mjs tests/production-deployment.test.mjs",
    "test:remote-rag": "node --env-file=.env.local scripts/verify-remote-rag.mjs",
    "test:remote-campaign": "node --env-file=.env.local scripts/verify-remote-campaign.mjs",
    "test:sites": "npm run build:sites && node --test tests/sites-worker.test.mjs",
    "validation:check": "node scripts/check-validation-toolchain.mjs",
    "chemistry:check": "node scripts/check-chemistry-service.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:lint": "supabase db lint --local"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.111.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "supabase": "^2.111.0"
  }
}
