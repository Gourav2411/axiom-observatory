# Server-only. Never expose this key through VITE_* variables or commit a real value.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Browser Auth. Publishable/anon keys are safe in the browser only because every
# exposed table and Storage bucket is protected by Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
# Browser UI switch only. Set true after the Google provider and redirect URLs
# are configured in Supabase; Google client secrets must never use a VITE_ prefix.
VITE_SUPABASE_GOOGLE_ENABLED=false

# Optional local scientific-worker endpoints. These are server-only and should
# point to isolated services that expose health/status plus explicit job APIs.
# Leaving them blank keeps the UI in honest "not configured" mode.
AXIOM_CHEMISTRY_URL=http://127.0.0.1:8791
AXIOM_RDKIT_WORKER_URL=
AXIOM_DOCKING_WORKER_URL=
AXIOM_ADMET_WORKER_URL=
AXIOM_RETROSYNTHESIS_WORKER_URL=

# Optional actual local execution adapters. Receptors must be PDBQT files under
# services/receptors. AiZynthFinder config must reference versioned policies and stock.
AXIOM_VINA_BINARY=
AXIOM_AIZYNTHFINDER_BINARY=
AXIOM_AIZYNTH_CONFIG=
AXIOM_CAMPAIGN_POLL_MS=2000
# Optional HMAC key for campaign manifests. Keep server-side; rotate through a
# versioned secret-management process. Without it manifests remain honestly unsigned.
AXIOM_ARTIFACT_SIGNING_KEY=
# Optional path to a validated endpoint-specific domain registry. Predictions remain not_evaluable without it.
AXIOM_ADMET_DOMAIN_REGISTRY=
# Clinical simulation adapters remain blocked unless real qualified workers are configured.
AXIOM_PBPK_URL=
AXIOM_POPPK_URL=
AXIOM_TRIAL_SIMULATION_URL=
